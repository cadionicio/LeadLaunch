{
  "info": {
    "name": "LeadLaunch · Matriz QA (CP-01 a CP-10)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con Run collection. Fuente: documento maestro §7.2. Resultados en RESULTADOS.md."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://leadlaunch-api.onrender.com/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token_b",
      "value": ""
    },
    {
      "key": "negocio_id",
      "value": ""
    },
    {
      "key": "correo_a",
      "value": ""
