  cotizaciones_cierre [label=<<TABLE BORDER="1" COLOR="#C9D5E8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#113CBA" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>cotizaciones_cierre</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="9" COLOR="#113CBA"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="cotizacion_id"><FONT POINT-SIZE="11" COLOR="#16233E"><B>cotizacion_id</B></FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="9" COLOR="#68738A"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="negocio_id"><FONT POINT-SIZE="11" COLOR="#16233E">negocio_id</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT" PORT="total_neto"><FONT POINT-SIZE="11" COLOR="#16233E">total_neto</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">numeric(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT" PORT="snapshot_reglas_json"><FONT POINT-SIZE="11" COLOR="#16233E">snapshot_reglas_json</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">jsonb</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT" PORT="estado"><FONT POINT-SIZE="11" COLOR="#16233E">estado</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">varchar(20)</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="9" COLOR="#68738A"><I>+ 10 atributos</I></FONT></TD></TR></TABLE>>];
  cotizacion_detalles [label=<<TABLE BORDER="1" COLOR="#C9D5E8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#113CBA" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>cotizacion_detalles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="9" COLOR="#113CBA"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="detalle_id"><FONT POINT-SIZE="11" COLOR="#16233E"><B>detalle_id</B></FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="9" COLOR="#68738A"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="cotizacion_id"><FONT POINT-SIZE="11" COLOR="#16233E">cotizacion_id</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="9" COLOR="#68738A"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="producto_id"><FONT POINT-SIZE="11" COLOR="#16233E">producto_id</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">uuid</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT" PORT="cantidad"><FONT POINT-SIZE="11" COLOR="#16233E">cantidad</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT" PORT="precio_unitario_snap"><FONT POINT-SIZE="11" COLOR="#16233E">precio_unitario_snap</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">numeric(10,2)</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="9" COLOR="#68738A"><I>+ 1 atributos</I></FONT></TD></TR></TABLE>>];
  bitacora_auditoria [label=<<TABLE BORDER="1" COLOR="#C9D5E8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#113CBA" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="12"><B>bitacora_auditoria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"><FONT POINT-SIZE="9" COLOR="#113CBA"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="auditoria_id"><FONT POINT-SIZE="11" COLOR="#16233E"><B>auditoria_id</B></FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">bigserial</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT" PORT="entidad_afectada"><FONT POINT-SIZE="11" COLOR="#16233E">entidad_afectada</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT" PORT="accion"><FONT POINT-SIZE="11" COLOR="#16233E">accion</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="22"> </TD><TD ALIGN="LEFT" PORT="detalle_json"><FONT POINT-SIZE="11" COLOR="#16233E">detalle_json</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="#68738A">jsonb</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" COLSPAN="2"><FONT POINT-SIZE="9" COLOR="#68738A"><I>+ 3 atributos</I></FONT></TD></TR></TABLE>>];
  usuarios -> negocios [dir=none];
  cat_rubros -> negocios [dir=none];
  negocios -> cat_politicas_negocio [dir=none];
  negocios -> cat_reglas_negocio [dir=none];
  negocios -> productos [dir=none];
  cat_rubros -> competidores_locales [dir=none];
  negocios -> eventos_escaneo_radar [dir=none];
  eventos_escaneo_radar -> hallazgos_friccion [dir=none];
  negocios -> hallazgos_friccion [dir=none];
  competidores_locales -> hallazgos_friccion [dir=none];
  cat_tipos_friccion -> hallazgos_friccion [dir=none];
  negocios -> campanas_adaptativas [dir=none];
  eventos_escaneo_radar -> campanas_adaptativas [dir=none];
  negocios -> cotizaciones_cierre [dir=none];
  cotizaciones_cierre -> cotizacion_detalles [dir=none];
  productos -> cotizacion_detalles [dir=none];
  cotizaciones_cierre -> bitacora_auditoria [style=dashed, dir=forward, arrowhead=vee, color="#7754E8", xlabel=<<FONT POINT-SIZE="10" COLOR="#7754E8">trigger</FONT>>];
  mv [label=<<TABLE BORDER="1" STYLE="dashed" COLOR="#129E61" CELLBORDER="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#129E61"><FONT COLOR="white" POINT-SIZE="12"><B>mv_resumen_comercial_negocio</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#16233E">Vista materializada del dashboard<BR ALIGN="LEFT"/>1 acceso indexado por negocio_id</FONT></TD></TR></TABLE>>];
  negocios -> mv [style=dashed, dir=forward, arrowhead=vee, color="#129E61"];
  { rank=same; usuarios; cat_rubros; cat_tipos_friccion; }
  { rank=same; negocios; competidores_locales; }
  { rank=same; cat_politicas_negocio; cat_reglas_negocio; productos; eventos_escaneo_radar; cotizaciones_cierre; }
  { rank=same; campanas_adaptativas; hallazgos_friccion; cotizacion_detalles; bitacora_auditoria; mv; }
  leyenda [label=<<TABLE BORDER="0" CELLSPACING="4" CELLPADDING="2"><TR><TD BGCOLOR="#7754E8" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#16233E">Catálogo (configuración)</FONT></TD></TR><TR><TD BGCOLOR="#175CF4" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#16233E">Parque (entidades)</FONT></TD></TR><TR><TD BGCOLOR="#113CBA" WIDTH="14" HEIGHT="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#16233E">Eventos (transacciones)</FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#68738A">PK clave primaria · FK clave foránea · ? admite nulo<BR ALIGN="LEFT"/>Notación pata de gallo: ‖ uno · ○ cero · ⋔ muchos</FONT></TD></TR></TABLE>>];
  { rank=same; leyenda; usuarios; }
  leyenda -> usuarios [style=invis, dir=none];
}
